rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return signedIn() && request.auth.token.email == 'oliviergnacadja693@gmail.com';
    }

    // Le profil est lisible par son propriétaire. Sa création initiale
    // est limitée à l'UID authentifié et à l'email de la session.
    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create: if isOwner(uid)
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email;
      allow update, delete: if false;
    }

    // Le wallet peut être créé à zéro lors de l'inscription, mais jamais
    // crédité ou débité depuis le navigateur.
    match /wallets/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create: if isOwner(uid)
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.soldeCauris == 0;
      allow update, delete: if false;
    }

    // Les transactions sont des preuves financières écrites par le backend.
    match /transactions/{transactionId} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid || isAdmin();
      allow write: if false;
    }

    // Les logs de consommation sont également écrits par le proxy serveur.
    match /usageLogs/{logId} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid || isAdmin();
      allow write: if false;
    }

    // Les clés API ne doivent jamais être lues ou écrites directement par le client.
    match /apiKeys/{uid} {
      allow read, write: if false;
    }

    // Configuration et pool financier réservés au backend/admin sécurisé.
    match /pricing/{document=**} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /poolImole/{document=**} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
